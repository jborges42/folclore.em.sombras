    },
    {
     "id": "cacadores_11",
     "tipo": "fala",
     "papel": "ze",
     "texto": "Derrubei! Viu só, Tião?",
     "inicio": 203.59,
     "fim": 206.068,
     "sfx": [
      {
       "som": "bloco_madeira",
       "t": 203.59
      },
