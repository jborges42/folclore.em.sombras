      }
     ]
    },
    {
     "id": "cacadores_12",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "E a mata ouviu.",
     "inicio": 206.368,
     "fim": 207.878,
     "sfx": [
      {
       "som": "bugio",
       "t": 207.878
      },
      {
       "som": "gongo_grave",
       "t": 207.878
      }
     ]
    },
    {
     "id": "cacadores_13",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "De tardinha, no riacho, apareceu a veada.",
     "inicio": 208.478,
     "fim": 211.628,
     "sfx": [
      {
       "som": "riacho",
       "t": 208.478
      },
      {
       "som": "coracao",
       "t": 211.628
      }
     ]
    },
    {
     "id": "cacadores_14",
     "tipo": "fala",
     "papel": "ze",
     "texto": "Tião... ela tá prenhe. Deixa essa.",
     "inicio": 212.128,
     "fim": 214.98,
     "sfx": [
      {
       "som": "coracao",
       "t": 212.128
      }
     ]
    },
    {
     "id": "cacadores_15",
     "tipo": "fala",
     "papel": "tiao",
     "texto": "Melhor ainda. São dois de uma vez.",
