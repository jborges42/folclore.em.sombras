    {
     "id": "cacadores_06",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Uma caiu. As outras rodaram no céu, gritando por ela.",
     "inicio": 183.735,
     "fim": 188.675,
     "sfx": [
      {
       "som": "araras",
       "t": 183.735
      }
     ]
    },
    {
     "id": "cacadores_07",
     "tipo": "fala",
     "papel": "tiao",
     "texto": "Arara não é de comer. Mas a pena fica bonita no chapéu.",
     "inicio": 189.175,
     "fim": 193.32,
     "sfx": []
    },
    {
     "id": "cacadores_08",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "E a mata ouviu.",
     "inicio": 193.62,
     "fim": 195.21,
     "sfx": [
      {
       "som": "gongo_grave",
       "t": 195.21
      },
      {
       "som": "folhagem_mexe",
       "t": 195.21
      }
     ]
    },
    {
     "id": "cacadores_09",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "O Zé, para mostrar serviço, meteu o facão numa embaúba nova.",
     "inicio": 195.81,
     "fim": 200.59,
     "sfx": []
    },
    {
     "id": "cacadores_10",
