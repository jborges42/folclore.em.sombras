      {
       "som": "folhagem_mexe",
       "t": 235.27
      }
     ]
    },
    {
     "id": "aviso_04",
     "tipo": "fala",
     "papel": "curupira",
     "texto": "Caça de fome, eu dou. Caça de gula, eu cobro. Quem mata por gosto perde o caminho de casa.",
     "inicio": 235.77,
     "fim": 245.943,
     "sfx": [
      {
       "som": "pau_de_chuva",
       "t": 235.77
      },
