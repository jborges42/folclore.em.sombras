       "som": "cachorro_latido",
       "t": 174.225
      }
     ]
    },
    {
     "id": "cacadores_04",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Antes do meio-dia, o bornal já dava para uma semana. Mas o Tião não parou.",
     "inicio": 174.525,
     "fim": 180.935,
     "sfx": [
