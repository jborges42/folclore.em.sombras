    {
     "id": "abertura_02",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Chega mais perto do fogo, que a história é velha. Mais velha que o avô do avô da gente.",
     "inicio": 2.5,
     "fim": 10.37,
     "sfx": [
      {
       "som": "lamparina_chama",
       "t": 2.5
      },
      {
