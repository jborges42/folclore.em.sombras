       "t": 10.37
      }
     ]
    },
    {
     "id": "abertura_03",
     "tipo": "pausa",
     "papel": null,
     "texto": null,
     "inicio": 10.87,
     "fim": 13.37,
     "sfx": [
      {
       "som": "tambor_grave",
       "t": 11.27
      },
      {
       "som": "flauta_chamado",
       "t": 12.47
      }
     ]
    },
    {
     "id": "abertura_04",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Em maio de mil quinhentos e sessenta, o padre José de Anchieta escreveu numa carta, em latim, estas palavras:",
     "inicio": 13.37,
     "fim": 21.39,
     "sfx": [
      {
       "som": "maraca",
       "t": 21.39
      }
     ]
    },
    {
     "id": "abertura_05",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "É coisa sabida, e pela boca de todos corre, que há certos demônios, a que os brasis chamam corupira.",
     "inicio": 21.89,
     "fim": 30.14,
     "sfx": [
      {
       "som": "gongo_grave",
       "t": 30.14
      }
     ]
    },
    {
     "id": "abertura_06",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Os indígenas deixavam penas, flechas e abanadores no alto da serra, pedindo aos curupiras que não fizessem mal.",
     "inicio": 30.74,
     "fim": 38.38,
     "sfx": [
      {
       "som": "vento_folhas",
       "t": 30.74
      },
      {
       "som": "caxixi",
       "t": 34.74
      }
     ]
    },
    {
     "id": "abertura_07",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Demônio foi a palavra do padre. Para os povos de língua tupi, ele era outra coisa.",
     "inicio": 38.88,
     "fim": 45.71,
     "sfx": [
      {
       "som": "tambor_grave",
       "t": 41.88
      }
     ]
    },
    {
     "id": "abertura_08",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Era o dono. Era a mãe do mato.",
     "inicio": 46.11,
     "fim": 49.91,
     "sfx": [
      {
       "som": "assobio_curupira",
       "t": 49.91
      }
     ]
    }
   ]
  },
