      }
     ]
    },
    {
     "id": "guardiao_02",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "O nome dele é Curupira. Em muitas terras, também o chamam de Caipora.",
     "inicio": 101.0,
     "fim": 106.6,
     "sfx": [
      {
       "som": "flauta_chamado",
       "t": 106.6
      }
     ]
    },
    {
     "id": "guardiao_03",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Pequenininho, coisa de quatro palmos. Mas com força de jogar caçador para o alto feito peteca.",
     "inicio": 107.0,
     "fim": 113.795,
     "sfx": [
      {
       "som": "prato",
       "t": 113.795
      }
     ]
    },
    {
     "id": "guardiao_04",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Uns dizem que é peludo, outros que tem dentes verdes.",
     "inicio": 114.195,
     "fim": 118.205,
     "sfx": [
      {
       "som": "caxixi",
       "t": 115.695
      }
     ]
    },
    {
     "id": "guardiao_05",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Nesta tela, é a lamparina que acende o cabelo dele, como brasa.",
     "inicio": 118.505,
     "fim": 123.695,
     "sfx": [
      {
       "som": "lamparina_chama",
       "t": 118.505
      }
     ]
    },
    {
     "id": "guardiao_06",
     "tipo": "pausa",
     "papel": null,
     "texto": null,
     "inicio": 124.195,
     "fim": 126.195,
     "sfx": [
      {
       "som": "bloco_madeira",
       "t": 124.595
      }
     ]
    },
    {
     "id": "guardiao_07",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Os pés dele são virados para trás.",
     "inicio": 126.195,
     "fim": 128.985,
     "sfx": [
      {
       "som": "berimbau",
       "t": 126.195
      },
      {
       "som": "passos_folhas",
       "t": 128.985
      }
     ]
    },
    {
     "id": "guardiao_08",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Por isso, quem segue o seu rastro vai para longe dele.",
     "inicio": 129.385,
     "fim": 133.475,
     "sfx": [
      {
       "som": "caxixi",
       "t": 133.475
      }
     ]
    },
    {
     "id": "guardiao_09",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Antes da tempestade, ele bate nas sapopemas, uma, duas, três vezes, para ver se as árvores aguentam.",
     "inicio": 133.875,
     "fim": 141.105,
     "sfx": [
      {
       "som": "batida_tronco",
       "t": 136.875
      },
      {
       "som": "batida_tronco",
       "t": 137.475
      },
      {
       "som": "batida_tronco",
       "t": 138.075
      },
      {
       "som": "trovao",
       "t": 141.105
      }
     ]
    },
    {
     "id": "guardiao_10",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Quem caça para comer, ele deixa.",
     "inicio": 141.605,
     "fim": 144.335,
     "sfx": [
      {
       "som": "inhambu",
       "t": 144.335
      }
     ]
    },
    {
     "id": "guardiao_11",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Mas quem mata por gosto, derruba árvore à toa ou mexe com bicho prenhe ou com filhote, esse se perde.",
     "inicio": 144.635,
     "fim": 152.215,
     "sfx": [
      {
       "som": "tambor_grave",
       "t": 147.135
      }
     ]
    },
    {
     "id": "guardiao_12",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "E não acha mais o caminho de casa.",
     "inicio": 152.515,
     "fim": 155.295,
     "sfx": [
      {
       "som": "gongo_desce",
       "t": 155.295
      }
     ]
    }
   ]
