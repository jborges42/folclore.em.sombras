     "fim": 170.755,
     "sfx": [
      {
       "som": "bloco_madeira",
       "t": 170.755
      }
     ]
    },
    {
     "id": "cacadores_03",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Atrás vinha o Zé, neto de benzedeira.",
     "inicio": 171.055,
     "fim": 174.225,
     "sfx": [
      {
       "som": "agogo",
       "t": 171.055
