    },
    {
     "id": "mata_02",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Lá longe, onde o rio faz a curva, tinha uma mata. E que mata!",
     "inicio": 58.91,
     "fim": 64.92,
     "sfx": [
      {
       "som": "riacho",
       "t": 58.91
      }
     ]
    },
    {
     "id": "mata_03",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "As araras cortavam o céu aos gritos, e os bugios roncavam no alto, como trovão manso.",
     "inicio": 65.32,
     "fim": 72.07,
     "sfx": [
      {
       "som": "araras_revoada",
       "t": 65.32
      },
      {
       "som": "agogo",
       "t": 65.82
      },
      {
       "som": "bugio",
       "t": 69.32
      }
     ]
    },
    {
     "id": "mata_04",
     "tipo": "pausa",
     "papel": null,
     "texto": null,
     "inicio": 72.47,
     "fim": 74.97,
     "sfx": [
      {
       "som": "passos_folhas",
       "t": 72.47
      },
      {
       "som": "caxixi",
       "t": 72.77
      },
      {
       "som": "onca_esturro",
       "t": 74.07
      }
     ]
    },
    {
     "id": "mata_05",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Na beira do riacho, uma veada de barriga redonda esperava filhote.",
     "inicio": 74.97,
     "fim": 79.75,
     "sfx": [
      {
       "som": "riacho",
       "t": 74.97
      },
      {
       "som": "flauta_chamado",
       "t": 79.75
      }
     ]
    },
    {
     "id": "mata_06",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Tudo ali tinha medida. Cada bicho tirava da mata só o que cabia na sua fome.",
     "inicio": 80.25,
     "fim": 86.36,
     "sfx": [
      {
       "som": "cigarras",
       "t": 80.25
      },
      {
       "som": "caxixi",
       "t": 83.25
      }
     ]
    },
    {
     "id": "mata_07",
     "tipo": "fala",
     "papel": "narrador",
     "texto": "Mas a mata tinha dono. E o dono vivia de orelha em pé.",
     "inicio": 86.86,
     "fim": 92.2,
     "sfx": [
      {
       "som": "gongo_grave",
       "t": 92.2
      },
      {
       "som": "folhagem_mexe",
       "t": 92.2
      }
     ]
    }
   ]
